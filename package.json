{
  "name": "abby-eyelash",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run start",
    "prebuild": "node scripts/prices.mjs",
    "build": "astro build",
    "start": "npm run build && npm run preview",
    "preview": "wrangler pages dev ./dist --port 8788 --ip 0.0.0.0 --binding BOOKING_DEMO=1",
    "pretest": "node scripts/prices.mjs",
    "test": "node --test",
    "check:seo": "node scripts/check-seo.mjs dist",
    "check:go-live": "node scripts/check-go-live.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
