{
  "name": "abby-eyelash",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run start",
    "prebuild": "node scripts/prices.mjs",
    "build": "astro build",
    "start": "npm run build && npm run preview",
    "prepreview": "node scripts/db.mjs up",
    "preview": "wrangler pages dev ./dist --port 8788 --ip 0.0.0.0 --compatibility-flags nodejs_compat --binding BOOKING_DEMO=1 --binding DATABASE_URL=postgres://abby_app:abby_dev@127.0.0.1:5434/postgres",
    "db": "node scripts/db.mjs up",
    "db:migrate": "node scripts/db.mjs migrate",
    "pretest": "node scripts/prices.mjs",
    "test": "node --test",
    "test:e2e": "node scripts/e2e-booking.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:seo": "node scripts/check-seo.mjs dist",
    "check:go-live": "node scripts/check-go-live.mjs",
    "check:looks": "npm run build && node scripts/check-looks.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "check:ga4": "node scripts/check-ga4.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "wrangler": "^4.152.0"
  }
}
