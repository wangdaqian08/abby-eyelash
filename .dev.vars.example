# Copy to .dev.vars for `npx wrangler pages dev ./dist` (never commit .dev.vars).
# Leave the three GOOGLE_* values empty to run in demo mode (mock availability, nothing written to a calendar).
# Demo mode is automatic on localhost. On a deployed preview set BOOKING_DEMO=1; without it, missing secrets return 503.
# BOOKING_DEMO=1

GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the "private_key" value from the service-account JSON, keeping the \n sequences, inside double quotes.
GOOGLE_PRIVATE_KEY=
# Abby's Gmail address (the calendar ID of her primary calendar).
GOOGLE_CALENDAR_ID=

# Cloudflare Turnstile test secret that always passes (https://developers.cloudflare.com/turnstile/troubleshooting/testing/).
# Remove the line to skip verification entirely in local demo mode.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Build-time (public) values are NOT read from this file — set them in .env or the Cloudflare Pages build env:
#   PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA     (test key, always passes)
#   PUBLIC_WEB3FORMS_ACCESS_KEY=                            (empty = no email notification)
