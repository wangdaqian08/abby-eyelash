---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TabBar from '../components/TabBar.astro';
import { lookOf } from '../lib/ab-test';
import { HREFLANG } from '../lib/i18n';
import SeoHead, { type Props as SeoProps } from '../components/seo/SeoHead.astro';
import Analytics from '../components/Analytics.astro';
import CookieConsent from '../components/CookieConsent.astro';
import playfair500 from '@fontsource/playfair-display/files/playfair-display-latin-500-normal.woff2?url';
import playfair500i from '@fontsource/playfair-display/files/playfair-display-latin-500-italic.woff2?url';

type Props = SeoProps;
const props = Astro.props;
const { lang, title, description } = props;
const look = lookOf(Astro.url);
---

<!doctype html>
<html lang={HREFLANG[lang]} data-look={look === 'B' ? 'B' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Headline fonts preloaded: a late swap re-wraps H1s and causes layout shift. -->
    <link rel="preload" href={playfair500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={playfair500i} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Arriving with a #section (e.g. /#gallery from another page): jump there instead of gliding down the whole page.
      // Smooth scrolling (global.css) comes back once the page has loaded, for in-page links.
      if (location.hash) {
        document.documentElement.style.scrollBehavior = 'auto';
        addEventListener('load', () => setTimeout(() => document.documentElement.style.removeProperty('scroll-behavior'), 100), { once: true });
      }
    </script>
    <SeoHead {...props} />
    <Analytics />
    <slot name="head" />
  </head>
  <body class="bg-bg text-fg antialiased">
    <a
      href="#main"
      class="sr-only z-[60] bg-primary px-4 py-3 text-on-primary focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
      >{lang !== 'en' ? '跳到主要内容' : 'Skip to content'}</a
    >
    <CookieConsent lang={lang} /><!-- early in the DOM so keyboard users reach it first; shown fixed at the bottom -->
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    {look === 'B' && <TabBar lang={lang} />}
    <script>
      // Press state for touch: phones apply :active late (or not at all) and a fast tap lifts before it shows.
      // data-pressed goes on at pointerdown and stays at least 140 ms; CSS styles it exactly like :active.
      document.addEventListener(
        'pointerdown',
        (e) => {
          const el = (e.target as Element).closest<HTMLElement>('a, button, label, summary');
          if (!el || el.matches(':disabled, [aria-disabled="true"]')) return;
          const t0 = performance.now();
          el.dataset.pressed = '';
          el.dataset.pressedAt = String(t0);
          const up = () => setTimeout(() => delete el.dataset.pressed, Math.max(0, 140 - (performance.now() - t0)));
          addEventListener('pointerup', up, { once: true });
          addEventListener('pointercancel', up, { once: true });
        },
        { passive: true },
      );
      // data-late: wait until the element is 30% up the screen (gallery rows), so the reveal happens where the eye is.
      const observer = (bottom: string) => {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }),
          { rootMargin: `0px 0px ${bottom} 0px` },
        );
        return io;
      };
      const io = observer('-10%'), late = observer('-30%');
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
        if (el.hasAttribute('data-stagger')) Array.from(el.children).forEach((c, i) => (c as HTMLElement).style.setProperty('--i', String(i)));
        (el.hasAttribute('data-late') ? late : io).observe(el);
      });
    </script>
  </body>
</html>
