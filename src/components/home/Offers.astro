---
import type { Lang } from '../../data/services';
import { common } from '../../i18n/common';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = common[lang].offers;
---
<section id="offers" class="py-16 md:py-20">
  <div data-reveal class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 md:grid-cols-[1fr_2fr] md:gap-16">
    <SectionHeading lang={lang} eyebrow={t.eyebrow} title={t.title} accent={t.accent} />
    <div>
      <ul data-reveal data-stagger class="grid gap-3 sm:grid-cols-2 lg:gap-4">
        {t.items.map((o) => (
          <li class="rounded-card bg-surface p-6">
            <h3 class="text-xl">{o.h}</h3>
            <p class="mt-2 text-muted">{o.p}</p>
          </li>
        ))}
      </ul>
      <p class="mt-4 text-sm text-muted">{t.note}</p>
    </div>
  </div>
</section>
