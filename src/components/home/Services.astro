---
import { services, type Lang } from '../../data/services';
import { common, priceLine } from '../../i18n/common';
import { localePath } from '../../lib/i18n';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = common[lang].services;
// Demo colour-fill hover + lift; focus-visible gets the same state (MASTER §4).
// Glass card over the section's colour blobs; lifts on hover, sinks on press (glass-press).
const card = 'group glass glass-strong glass-press relative flex flex-col rounded-[1.6rem] p-6 sm:p-8 focus-visible:z-10';
const onFill = '';
const small = lang === 'en' ? 'text-[0.8125rem] uppercase tracking-[0.2em]' : 'text-sm';
---
<section id="services" class="blobs bg-surface-2 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div data-reveal class="grid gap-8 md:grid-cols-2 md:items-end md:gap-16">
      <SectionHeading lang={lang} eyebrow={t.eyebrow} title={t.title} accent={t.accent} />
      <p class="max-w-md text-muted md:justify-self-end">{t.intro}</p>
    </div>

    <ul data-reveal data-stagger class="mt-12 grid gap-3 sm:grid-cols-2 md:mt-16 lg:grid-cols-3 lg:gap-4">
      {services.map((s) => (
        <li class="flex">
          <a href={localePath(lang, s.slug)} class:list={[card, 'w-full']}>
            <h3 class:list={['text-xl', onFill]}>{s.name[lang]}</h3>
            <p class="mt-3 flex-1 text-muted">{s.summary[lang]}</p>
            <p class:list={['mt-6 font-medium tabular-nums', onFill]}>{priceLine(s, lang)}</p>
            <span class:list={['mt-4 inline-flex items-center gap-2 text-accent-ink', small, onFill]}>
              {t.details}
              <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">→</span>
            </span>
          </a>
        </li>
      ))}
      <li class="flex">
        <a href={localePath(lang, '/book')} data-track="book_click" class:list={[card, 'glass-tint w-full']}>
          <h3 class:list={['text-xl', onFill]}><em class="text-on-primary">{t.ctaTitle}</em></h3>
          <p class="mt-3 flex-1 text-on-primary/85">{t.ctaBody}</p>
          <span class:list={['mt-6 inline-flex items-center gap-2 text-on-primary', small]}>
            {t.ctaLink}
            <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">→</span>
          </span>
        </a>
      </li>
    </ul>
  </div>
</section>
