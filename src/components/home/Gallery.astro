---
// Home portfolio: three parts (lashes, nails, brows), each by service, then by style (src/data/photos.ts adminGroups; Abby edits the
// lists in /admin/). Lashes start with 整脸效果. A group with no photos, and a service with none, is not shown. Every photo is in the HTML;
// photos past the first row of a group sit in a grid-collapse opened by that part's "Show all" button.
import { Picture, getImage } from 'astro:assets';
import type { Lang } from '../../data/services';
import { site } from '../../data/site';
import { FACE, adminData, adminGroups, bookingHref, photo, photoBooking, photoNumber, videos, type AdminGroup, type Dir } from '../../data/photos';
import { services } from '../../data/services';
import { common, fill } from '../../i18n/common';
import { localePath } from '../../lib/i18n';
import { photoSrc } from '../../lib/photo-src';
import SectionHeading from '../ui/SectionHeading.astro';
import { lookOf } from '../../lib/ab-test';
const lookB = lookOf(Astro.url) === 'B'; // look B markup (lib/ab-test.ts)

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = common[lang].gallery;
const posterUrl = Object.fromEntries(await Promise.all(Object.entries(videos).map(async ([id, v]) => [id, (await getImage({ src: photoSrc(v.poster), width: 480, format: 'webp' })).src])));

type Group = AdminGroup & { items: string[] };
// One section per service (整脸效果 is its own, first): its heading, then its style groups. A style heading is shown only when the
// service has more than one group (nail extensions has only "Other", 整脸效果 only itself).
const sectionsOf = (dir: Dir) => {
  const groups = adminGroups.filter((g) => g.dir === dir).map((g) => ({ ...g, items: adminData.groups[g.id] }));
  const keys = [...new Set(groups.map((g) => (g.id === 'face' ? 'face' : g.service)))];
  return keys.map((k) => {
    const all = groups.filter((g) => (g.id === 'face' ? 'face' : g.service) === k);
    return { title: k === 'face' ? FACE : services.find((s) => s.id === k)!.name, styled: all.length > 1, groups: all.filter((g) => g.items.length) };
  }).filter((s) => s.groups.length);
};
const parts = [
  { id: 'lashes', title: t.lashes, sections: sectionsOf('lash'), book: `${localePath(lang, '/book')}?service=lash-extensions`, bookLabel: t.bookLashes },
  { id: 'nails', title: t.nails, sections: sectionsOf('nails'), book: `${localePath(lang, '/book')}?service=gel-nails`, bookLabel: t.bookNails },
  { id: 'brows', title: t.brows, sections: sectionsOf('brows'), book: `${localePath(lang, '/book')}?service=powder-brows`, bookLabel: t.bookBrows },
];
// Nails and brows: three portrait tiles per row. Lashes: two per row on phones, four on desktop.
const grid = (p: string) => (p === 'nails' || p === 'brows' ? 'grid grid-cols-3 gap-2' : 'grid grid-cols-2 gap-2 lg:grid-cols-4');
const sizes = (p: string) => (p === 'nails' || p === 'brows' ? '(min-width: 1152px) 360px, 31vw' : '(min-width: 1024px) 270px, 47vw');
const aspect = { '3:4': 'aspect-[3/4]', '4:3': 'aspect-[4/3]' };
// Each photo opens its booking (photoBooking) and shows its style in a bar under the photo ("Other": the service name, muted).
// data-photo is its number (gel-nails-cat-eye-1): GA4 reports which photos people tap to book; visitors never see it.
const booking = (id: string) => photoBooking(id)!;
const href = (id: string) => bookingHref(lang, id, booking(id));
// The card is the link itself, so its focus ring is not clipped and a tap presses it (data-pressed); a video tile keeps it on the <li>.
// @container: the bar text follows the card's width (cqi), 12px on the smallest phone card up to 15px on the wide desktop one.
const CARD = 'group/card @container overflow-hidden rounded-field bg-surface-3 shadow-[var(--shadow-soft)] transition duration-300 ease-brand hover:-translate-y-0.5 hover:shadow-lift active:scale-[.98]';
// Golden ratio inside the bar, all in em so it scales as one piece: line 1.618em, padding 0.382em : 0.618em, chevron 0.786em.
const BAR = 'flex items-center justify-between gap-[.382em] px-[.618em] py-[.382em] text-[length:clamp(12px,9.4px_+_1.45cqi,15px)] leading-[1.618]';
---
<section id="gallery" class="bg-surface-2 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div data-reveal class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading lang={lang} eyebrow={t.eyebrow} title={t.title} accent={t.accent} />
      <a href={site.social.instagram} data-track="social_click" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center text-sm text-muted underline underline-offset-4 transition-colors duration-200 hover:text-fg">{t.more}</a>
    </div>

    {parts.map((part) => {
      const count = part.sections.flatMap((s) => s.groups).reduce((n, g) => n + g.items.length, 0);
      const bar = (id: string) => {
        const b = booking(id);
        return (
          <>
            <span class:list={['min-w-0 truncate transition-colors duration-200 group-hover/card:text-primary', b.muted ? 'text-muted' : 'font-medium']}>{b.name[lang]}</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="size-[.786em] shrink-0 text-accent-ink transition-transform duration-200 group-hover/card:translate-x-0.5"><path d="m9 6 6 6-6 6" /></svg>
          </>
        );
      };
      const tiles = (g: Group, ids: string[]) => (
        <ul data-reveal data-stagger data-late class={grid(part.id)}>
          {ids.map((id) => (
            <li class={videos[id] ? `${CARD} has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-primary` : undefined}>
              {videos[id] ? (
                <>
                  <div class:list={['relative bg-fg/5', aspect[g.ratio]]}>
                    <video muted loop playsinline preload="none" poster={posterUrl[id]} width="480" height="640" class="aspect-[3/4] size-full object-cover" aria-label={videos[id].alt[lang]} data-video>
                      <source src={videos[id].src} type="video/mp4" />
                    </video>
                    <button type="button" data-video-toggle aria-pressed="false" aria-label={t.playVideo} class="group absolute inset-0">
                      <span aria-hidden="true" class="absolute right-1.5 top-1.5 flex size-6 items-center justify-center rounded-full bg-surface/80 text-fg backdrop-blur-sm transition-opacity duration-200 group-aria-pressed:opacity-0">
                        <svg viewBox="0 0 24 24" class="size-3 translate-x-px" fill="currentColor"><path d="M7 5v14l12-7z" /></svg>
                      </span>
                    </button>
                  </div>
                  <a href={href(id)} data-track="book_click" data-photo={photoNumber(id)} class={BAR} data-bar>{bar(id)}</a>
                </>
              ) : (
                <a href={href(id)} data-track="book_click" data-photo={photoNumber(id)} class:list={['block', CARD]}>
                  <span class:list={['block overflow-hidden bg-fg/5', aspect[g.ratio]]}>
                    {/* a photo moved from a group of the other shape is cropped from its top, where the eyes or nails are */}
                    <Picture src={photoSrc(id)} alt={photo(id).alt[lang]} formats={['avif', 'webp']} widths={[240, 480, 720]} sizes={sizes(part.id)} loading="lazy" class:list={['size-full object-cover transition-transform duration-700 ease-soft group-hover/card:scale-[1.04]', photo(id).ratio !== g.ratio && 'object-top']} />
                  </span>
                  <span class={BAR} data-bar>{bar(id)}</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      );
      return (
        <div data-part class="mt-12 md:mt-16">
          <h3 class="text-2xl md:text-3xl">{part.title}</h3>
          <div class="mt-6 space-y-10">
            {part.sections.map((sec) => (
              <div data-service>
                <h4 class="text-[17px] font-semibold">{sec.title[lang]}</h4>
                <div class="mt-3 space-y-6">
                  {sec.groups.map((g) => (
                    <div data-group={g.id}>
                      {sec.styled && <h5 class="mb-2.5 text-sm font-medium text-muted">{g.name[lang]}</h5>}
                      {tiles(g, g.items.slice(0, g.visible))}
                      {g.items.length > g.visible && (
                        <div data-more class="grid-collapse">
                          <div><div class="pt-2">{tiles(g, g.items.slice(g.visible))}</div></div>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
            <button type="button" data-show-all aria-expanded="false" hidden data-all={fill(t.showAll, { n: count })} data-less={t.showLess} class={lookB ? "btn-tinted press inline-flex min-h-11 items-center rounded-full px-5 text-sm font-medium" : "inline-flex min-h-11 items-center btn-soft rounded-full bg-surface px-5 text-sm font-medium transition duration-200 hover:bg-surface-3 active:scale-[.97]"}>{fill(t.showAll, { n: count })}</button>
            <a href={part.book} data-track="book_click" class="inline-flex min-h-11 items-center text-sm text-muted underline underline-offset-4 transition-colors duration-200 hover:text-fg">{part.bookLabel}</a>
          </div>
        </div>
      );
    })}
  </div>
</section>
<script>
  // Each part has its own "Show all": hidden rows are inert until opened, so keyboard and screen-reader users skip them.
  document.querySelectorAll<HTMLElement>('#gallery [data-part]').forEach((part) => {
    const btn = part.querySelector<HTMLButtonElement>('[data-show-all]');
    const rows = part.querySelectorAll<HTMLElement>('[data-more]');
    if (!btn || !rows.length) return;
    rows.forEach((r) => r.setAttribute('inert', ''));
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      rows.forEach((r) => {
        r.classList.toggle('is-open', open);
        r.toggleAttribute('inert', !open);
      });
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? btn.dataset.less! : btn.dataset.all!;
    });
  });
  // No autoplay. Hover plays on mouse devices (unless reduced motion); tap or Enter toggles everywhere.
  document.querySelectorAll<HTMLVideoElement>('#gallery [data-video]').forEach((video) => {
    const toggle = video.parentElement!.querySelector<HTMLButtonElement>('[data-video-toggle]')!;
    const set = (play: boolean) => {
      if (play) video.play().catch(() => {}); else video.pause();
      toggle.setAttribute('aria-pressed', String(play));
    };
    toggle.addEventListener('click', () => set(video.paused));
    if (matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
      toggle.addEventListener('mouseenter', () => set(true));
      toggle.addEventListener('mouseleave', () => set(false));
    }
  });
</script>
