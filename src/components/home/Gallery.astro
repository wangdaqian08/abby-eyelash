---
import { Picture, getImage } from 'astro:assets';
import type { Lang } from '../../data/services';
import { site } from '../../data/site';
import { NAIL_VISIBLE, nailGroups, nailVideo, photo } from '../../data/photos';
import { common } from '../../i18n/common';
import { localePath } from '../../lib/i18n';
import { photoSrc } from '../../lib/photo-src';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = common[lang].gallery;
const posterUrl = (await getImage({ src: photoSrc(nailVideo.poster), width: 480, format: 'webp' })).src;
const bookHref = `${localePath(lang, '/book')}?service=gel-nails`;
---
<section id="gallery" class="bg-surface-2 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div data-reveal class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading lang={lang} eyebrow={t.eyebrow} title={t.title} accent={t.accent} />
      <a href={site.social.instagram} data-track="social_click" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center text-sm text-muted underline underline-offset-4 transition-colors duration-200 hover:text-fg">{t.more}</a>
    </div>
    <div data-reveal data-stagger class="mt-12 space-y-8 md:mt-16">
      {nailGroups.map((g) => {
        const tiles = (ids: string[]) => (
          <ul class="grid grid-cols-3 gap-2">
            {ids.map((id) => (
              <li class="relative aspect-[3/4] overflow-hidden rounded-field bg-surface">
                {id === 'video' ? (
                  <video muted loop playsinline preload="none" poster={posterUrl} width="480" height="640" class="aspect-[3/4] size-full object-cover" aria-label={nailVideo.alt[lang]} data-video>
                    <source src={nailVideo.src} type="video/mp4" />
                  </video>
                  <button type="button" data-video-toggle aria-pressed="false" aria-label={t.playVideo} class="group absolute inset-0">
                    <span aria-hidden="true" class="absolute right-1.5 top-1.5 flex size-6 items-center justify-center rounded-full bg-surface/80 text-fg backdrop-blur-sm transition-opacity duration-200 group-aria-pressed:opacity-0">
                      <svg viewBox="0 0 24 24" class="size-3 translate-x-px" fill="currentColor"><path d="M7 5v14l12-7z" /></svg>
                    </span>
                  </button>
                ) : (
                  <Picture
                    src={photoSrc(id)}
                    alt={photo(id).alt[lang]}
                    formats={['avif', 'webp']}
                    widths={[240, 480, 720]}
                    sizes="(min-width: 1152px) 360px, 31vw"
                    loading="lazy"
                    class="size-full object-cover"
                  />
                )}
              </li>
            ))}
          </ul>
        );
        return (
          <div>
            <h3 class="mb-3 flex items-center gap-2 text-sm font-medium">
              <span class="size-2.5 rounded-full" style={`background:${g.swatch}`} aria-hidden="true"></span>
              {g.name[lang]}
            </h3>
            {tiles(g.items.slice(0, NAIL_VISIBLE))}
            {g.items.length > NAIL_VISIBLE && (
              <div data-more class="grid-collapse">
                <div><div class="pt-2">{tiles(g.items.slice(NAIL_VISIBLE))}</div></div>
              </div>
            )}
          </div>
        );
      })}
    </div>
    <div class="mt-8 flex flex-wrap items-center gap-x-6">
      <button type="button" data-show-all aria-expanded="false" hidden data-all={t.showAll} data-less={t.showLess} class="inline-flex min-h-11 items-center rounded-full bg-surface px-5 text-sm font-medium transition duration-200 hover:bg-surface-2 active:scale-[.97]">{t.showAll}</button>
      <a href={bookHref} data-track="book_click" class="inline-flex min-h-11 items-center text-sm text-muted underline underline-offset-4 transition-colors duration-200 hover:text-fg">{t.bookNails}</a>
    </div>
  </div>
</section>
<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-show-all]');
  const rows = document.querySelectorAll<HTMLElement>('[data-more]');
  if (btn) {
    rows.forEach((r) => r.setAttribute('inert', ''));
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      rows.forEach((r) => {
        r.classList.toggle('is-open', open);
        r.toggleAttribute('inert', !open);
      });
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? btn.dataset.less! : btn.dataset.all!;
    });
  }
  // No autoplay. Hover plays on mouse devices (unless reduced motion); tap or Enter toggles everywhere.
  const video = document.querySelector<HTMLVideoElement>('[data-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-video-toggle]');
  if (video && toggle) {
    const set = (play: boolean) => {
      if (play) video.play().catch(() => {}); else video.pause();
      toggle.setAttribute('aria-pressed', String(play));
    };
    toggle.addEventListener('click', () => set(video.paused));
    if (matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
      toggle.addEventListener('mouseenter', () => set(true));
      toggle.addEventListener('mouseleave', () => set(false));
    }
  }
</script>
