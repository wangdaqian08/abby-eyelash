---
// Home portfolio: a lash part (grouped by look) and a nail part (grouped by colour). Every photo is in the HTML;
// photos past the first row of a group sit in a grid-collapse opened by that part's "Show all" button.
import { Picture, getImage } from 'astro:assets';
import type { Lang } from '../../data/services';
import { site } from '../../data/site';
import { LASH_VISIBLE, NAIL_VISIBLE, lashGroups, nailGroups, nailVideo, photo } from '../../data/photos';
import { common, fill } from '../../i18n/common';
import { localePath } from '../../lib/i18n';
import { photoSrc } from '../../lib/photo-src';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = common[lang].gallery;
const posterUrl = (await getImage({ src: photoSrc(nailVideo.poster), width: 480, format: 'webp' })).src;

type Group = { id: string; name: { en: string; zh: string }; swatch?: string; ratio: '3:4' | '4:3'; items: string[] };
const parts: { id: string; title: string; groups: Group[]; visible: number; book: string; bookLabel: string }[] = [
  { id: 'lashes', title: t.lashes, groups: lashGroups, visible: LASH_VISIBLE, book: `${localePath(lang, '/book')}?service=lash-extensions`, bookLabel: t.bookLashes },
  { id: 'nails', title: t.nails, groups: nailGroups.map((g) => ({ ...g, ratio: '3:4' as const })), visible: NAIL_VISIBLE, book: `${localePath(lang, '/book')}?service=gel-nails`, bookLabel: t.bookNails },
];
// Nails: three portrait tiles per row (as before). Lashes: two per row on phones, four on desktop.
const grid = (p: string) => (p === 'nails' ? 'grid grid-cols-3 gap-2' : 'grid grid-cols-2 gap-2 lg:grid-cols-4');
const sizes = (p: string) => (p === 'nails' ? '(min-width: 1152px) 360px, 31vw' : '(min-width: 1024px) 270px, 47vw');
const aspect = { '3:4': 'aspect-[3/4]', '4:3': 'aspect-[4/3]' };
---
<section id="gallery" class="bg-surface-2 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div data-reveal class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading lang={lang} eyebrow={t.eyebrow} title={t.title} accent={t.accent} />
      <a href={site.social.instagram} data-track="social_click" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center text-sm text-muted underline underline-offset-4 transition-colors duration-200 hover:text-fg">{t.more}</a>
    </div>

    {parts.map((part) => {
      const count = part.groups.reduce((n, g) => n + g.items.length, 0);
      const tiles = (g: Group, ids: string[]) => (
        <ul class={grid(part.id)}>
          {ids.map((id) => (
            <li class:list={['relative overflow-hidden rounded-field bg-surface', aspect[g.ratio]]}>
              {id === 'video' ? (
                <>
                  <video muted loop playsinline preload="none" poster={posterUrl} width="480" height="640" class="aspect-[3/4] size-full object-cover" aria-label={nailVideo.alt[lang]} data-video>
                    <source src={nailVideo.src} type="video/mp4" />
                  </video>
                  <button type="button" data-video-toggle aria-pressed="false" aria-label={t.playVideo} class="group absolute inset-0">
                    <span aria-hidden="true" class="absolute right-1.5 top-1.5 flex size-6 items-center justify-center rounded-full bg-surface/80 text-fg backdrop-blur-sm transition-opacity duration-200 group-aria-pressed:opacity-0">
                      <svg viewBox="0 0 24 24" class="size-3 translate-x-px" fill="currentColor"><path d="M7 5v14l12-7z" /></svg>
                    </span>
                  </button>
                </>
              ) : (
                <Picture src={photoSrc(id)} alt={photo(id).alt[lang]} formats={['avif', 'webp']} widths={[240, 480, 720]} sizes={sizes(part.id)} loading="lazy" class="size-full object-cover" />
              )}
            </li>
          ))}
        </ul>
      );
      return (
        <div data-part class="mt-12 md:mt-16">
          <h3 class="text-2xl md:text-3xl">{part.title}</h3>
          <div data-reveal data-stagger class="mt-6 space-y-8">
            {part.groups.map((g) => (
              <div>
                <h4 class="mb-3 flex items-center gap-2 text-sm font-medium">
                  {g.swatch && <span class="size-2.5 rounded-full" style={`background:${g.swatch}`} aria-hidden="true"></span>}
                  {g.name[lang]}
                </h4>
                {tiles(g, g.items.slice(0, part.visible))}
                {g.items.length > part.visible && (
                  <div data-more class="grid-collapse">
                    <div><div class="pt-2">{tiles(g, g.items.slice(part.visible))}</div></div>
                  </div>
                )}
              </div>
            ))}
          </div>
          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
            <button type="button" data-show-all aria-expanded="false" hidden data-all={fill(t.showAll, { n: count })} data-less={t.showLess} class="inline-flex min-h-11 items-center btn-soft rounded-full bg-surface px-5 text-sm font-medium transition duration-200 hover:bg-surface-3 active:scale-[.97]">{fill(t.showAll, { n: count })}</button>
            <a href={part.book} data-track="book_click" class="inline-flex min-h-11 items-center text-sm text-muted underline underline-offset-4 transition-colors duration-200 hover:text-fg">{part.bookLabel}</a>
          </div>
        </div>
      );
    })}
  </div>
</section>
<script>
  // Each part has its own "Show all": hidden rows are inert until opened, so keyboard and screen-reader users skip them.
  document.querySelectorAll<HTMLElement>('#gallery [data-part]').forEach((part) => {
    const btn = part.querySelector<HTMLButtonElement>('[data-show-all]');
    const rows = part.querySelectorAll<HTMLElement>('[data-more]');
    if (!btn || !rows.length) return;
    rows.forEach((r) => r.setAttribute('inert', ''));
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      rows.forEach((r) => {
        r.classList.toggle('is-open', open);
        r.toggleAttribute('inert', !open);
      });
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? btn.dataset.less! : btn.dataset.all!;
    });
  });
  // No autoplay. Hover plays on mouse devices (unless reduced motion); tap or Enter toggles everywhere.
  const video = document.querySelector<HTMLVideoElement>('[data-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-video-toggle]');
  if (video && toggle) {
    const set = (play: boolean) => {
      if (play) video.play().catch(() => {}); else video.pause();
      toggle.setAttribute('aria-pressed', String(play));
    };
    toggle.addEventListener('click', () => set(video.paused));
    if (matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
      toggle.addEventListener('mouseenter', () => set(true));
      toggle.addEventListener('mouseleave', () => set(false));
    }
  }
</script>
