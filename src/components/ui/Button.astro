---
// Link styled as a button. variant: primary (filled) | outline | inverse (outline on --primary bands).
// `track` sets data-track for GA4 (book_click, message_click, map_click, review_click, social_click).
import type { HTMLAttributes } from 'astro/types';
import type { Lang } from '../../data/services';
import { lookOf } from '../../lib/ab-test';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  lang: Lang;
  variant?: 'primary' | 'outline' | 'inverse' | 'glass';
  track?: string;
}
const { href, lang, variant = 'primary', track, class: cls, ...rest } = Astro.props;
const b = lookOf(Astro.url) === 'B';
const variants = b
  ? { primary: 'btn-solid press', outline: 'btn-tinted press', inverse: 'glass press text-on-primary', glass: 'glass press text-fg' }
  : {
      primary: 'btn-raise bg-primary text-on-primary hover:bg-primary/90',
      outline: 'btn-soft border border-primary/30 text-primary hover:bg-surface-2',
      inverse: 'btn-soft border border-on-primary/40 text-on-primary hover:bg-on-primary hover:text-primary',
      glass: '', // look B only
    };
---
<a
  href={href}
  data-track={track}
  class:list={[
    b ? 'inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-7 text-center font-medium ' : 'inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-7 text-center font-medium transition duration-200 ease-brand active:scale-[.97]',
    lang === 'en' ? 'text-xs uppercase tracking-[0.2em]' : 'text-sm',
    variants[variant],
    cls,
  ]}
  {...rest}
><slot /></a>
