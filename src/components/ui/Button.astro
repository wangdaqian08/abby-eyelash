---
// Link styled as a button. variant: primary (filled) | outline | inverse (outline on --primary bands).
// `track` sets data-track for GA4 (book_click, message_click, map_click, review_click, social_click).
import type { HTMLAttributes } from 'astro/types';
import type { Lang } from '../../data/services';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  lang: Lang;
  variant?: 'primary' | 'outline' | 'inverse';
  track?: string;
}
const { href, lang, variant = 'primary', track, class: cls, ...rest } = Astro.props;
const variants = {
  primary: 'glass glass-tint glass-press',
  outline: 'glass glass-strong glass-press text-primary',
  inverse: 'glass glass-press text-on-primary',
};
---
<a
  href={href}
  data-track={track}
  class:list={[
    'inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-7 text-center font-medium ',
    lang === 'en' ? 'text-xs uppercase tracking-[0.2em]' : 'text-sm',
    variants[variant],
    cls,
  ]}
  {...rest}
><slot /></a>
