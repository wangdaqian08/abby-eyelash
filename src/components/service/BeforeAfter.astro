---
// Two stacked before/after masters side by side. Each image: top half = before, bottom half = after (two different clients).
import { Picture } from 'astro:assets';
import type { Lang } from '../../data/services';
import { photo } from '../../data/photos';
import { serviceStrings } from '../../i18n/service';
import { photoSrc } from '../../lib/photo-src';

interface Props { lang: Lang; ids: [string, string] }
const { lang, ids } = Astro.props;
const t = serviceStrings[lang];
const label = 'absolute left-2 px-2 py-1 text-xs font-medium bg-surface-3/90';
---
<div class="grid grid-cols-2 gap-3">
  {ids.map((id) => (
    <figure class="relative">
      <Picture
        src={photoSrc(id)}
        alt={photo(id).alt[lang]}
        formats={['avif', 'webp']}
        widths={[320, 480, 960]}
        sizes="(min-width: 1024px) 240px, 47vw"
        loading="lazy"
        class="h-auto w-full"
      />
      <span aria-hidden="true" class:list={[label, 'top-2']}>{t.before}</span>
      <span aria-hidden="true" class:list={[label, 'top-[calc(50%+0.5rem)]']}>{t.after}</span>
      <figcaption class="sr-only">{t.beforeAfterCaption}</figcaption>
    </figure>
  ))}
</div>
