---
// A manifest photo (src/data/photos.ts) via <Picture>; without `photo`, a token-coloured placeholder (powder brows).
import { Picture } from 'astro:assets';
import type { Lang } from '../../data/services';
import { photo as photoMeta } from '../../data/photos';
import { photoSrc } from '../../lib/photo-src';

interface Props {
  photo?: string;
  lang: Lang;
  alt?: string; // placeholder label only
  class?: string;
  eager?: boolean;
  position?: string;
}
const { photo, lang, alt, class: cls = '', eager = false, position } = Astro.props;
const src = photo ? photoSrc(photo) : undefined;
const widths = [480, 960, 1440].filter((w) => w <= (src?.width ?? 0)); // never above the master's width
---

{
  photo ? (
    <Picture
      src={src!}
      alt={photoMeta(photo).alt[lang]}
      formats={['avif', 'webp']}
      widths={widths}
      sizes="(min-width: 1024px) 480px, 100vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      class:list={['h-full w-full object-cover', cls]}
      style={position ? `object-position:${position}` : undefined}
    />
  ) : (
    <div role="img" aria-label={alt} class:list={['relative overflow-hidden bg-surface-2', cls]}>
      <div class="absolute inset-4 border border-border" />
      <div
        class="absolute inset-0 opacity-60"
        style="background-image: repeating-linear-gradient(135deg, transparent 0 22px, var(--border) 22px 23px)"
      />
      <span aria-hidden="true" class="absolute inset-0 flex items-center justify-center font-serif text-5xl text-accent">✦</span>
    </div>
  )
}
