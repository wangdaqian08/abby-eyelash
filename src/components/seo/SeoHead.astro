---
// Canonical, hreflang, robots, Open Graph/Twitter and JSON-LD (docs/GEO-STRATEGY.md #5, #11, #12, #13).
import type { Lang } from '../../data/services';
import { site } from '../../data/site';
import { HREFLANG, LANGS, localePath } from '../../lib/i18n';
import { abs, buildGraph, pagePath } from '../../lib/schema';
import { publicPath } from '../../lib/ab-test';

export interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Extra page-specific JSON-LD nodes (Service, BreadcrumbList…). Must mirror visible content. */
  schema?: Record<string, unknown>[];
  /** Absolute or root-relative OG image. */
  image?: string;
  /** ISO date of the last real content change. */
  updated?: string;
  noindex?: boolean;
}
const { lang, title, description, schema, image = '/og-default.jpg', updated, noindex } = Astro.props;
const base = Astro.site!;
const pathname = publicPath(Astro.url.pathname); // look-B pages describe the public URL
const path = pagePath(pathname);
const canonical = abs(base, localePath(lang, path));
const ogImage = abs(base, image);
const ogLocale: Record<Lang, string> = { en: 'en_AU', zh: 'zh_CN', 'zh-hant': 'zh_TW' };
// Escape "<" so content can never close the script element.
const jsonLd = JSON.stringify(
  buildGraph({ site: base, lang, pathname, title, image: ogImage, updated, extra: schema }),
).replace(/</g, '\\u003c');
---
{/* Never add nosnippet / max-snippet / noarchive / nocache (GEO-STRATEGY #5). */}
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
{!noindex && (
  <>
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={HREFLANG[l]} href={abs(base, localePath(l, path))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(base, localePath('en', path))} />
  </>
)}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{image === '/og-default.jpg' && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
<meta property="og:locale" content={ogLocale[lang]} />
{LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{!noindex && <script type="application/ld+json" is:inline set:html={jsonLd} />}
