---
// Fixed translucent header: logo, home-section nav, language switch, Book CTA, accessible mobile menu.
import type { Lang } from '../data/services';
import { site } from '../data/site';
import { common } from '../i18n/common';
import { localePath } from '../lib/i18n';
import LangSwitch from './ui/LangSwitch.astro';
import Button from './ui/Button.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = common[lang].nav;
const home = localePath(lang, '/');
// "/#services" works both as an in-page anchor on home and as a link from other pages.
const links = [
  ['services', t.services],
  ['about', t.about],
  ['gallery', t.gallery],
  ['reviews', t.reviews],
  ['contact', t.contact],
].map(([id, label]) => ({ href: `${home}#${id}`, label }));
const book = localePath(lang, '/book');
---
<header data-header class="fixed inset-x-3 top-3 z-50 sm:inset-x-4">
  <div class="glass mx-auto flex h-14 max-w-6xl items-center justify-between gap-3 rounded-full pl-5 pr-2 sm:gap-6 sm:pl-6 sm:pr-2">
    <a href={home} aria-label={t.home} class="flex min-h-11 items-center gap-3">
      <span class="whitespace-nowrap font-serif text-xl leading-none sm:text-2xl text-primary">{site.name}</span>
      <span class:list={['hidden text-muted xl:inline', lang === 'en' ? 'text-[0.6875rem] uppercase tracking-[0.25em]' : 'text-xs']}>{t.tagline}</span>
    </a>

    <nav aria-label={t.main} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {links.map((l) => (
          <li><a href={l.href} class="inline-flex min-h-10 items-center rounded-full px-3.5 text-sm text-muted transition duration-200 hover:bg-surface-3/60 hover:text-fg">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2 sm:gap-4">
      <LangSwitch lang={lang} />
      <Button href={book} lang={lang} track="book_click" class="min-h-10! px-5! max-lg:hidden">{t.book}</Button>
      <button
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.openMenu}
        data-label-open={t.openMenu}
        data-label-close={t.closeMenu}
        class="inline-flex size-10 items-center justify-center rounded-full text-fg transition duration-200 active:bg-surface-3/70 lg:hidden"
      >
        <svg data-icon-open viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <svg data-icon-close viewBox="0 0 24 24" class="hidden size-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
  </div>

  {/* `hidden` keeps it closed without JS; the script swaps it for the grid-collapse animation. */}
  <div id="mobile-menu" hidden class="grid-collapse lg:hidden">
    <div>
      <nav aria-label={t.main} class="glass glass-strong mx-auto mt-2 max-w-6xl rounded-card px-5 pb-5 pt-2">
        <ul>
          {links.map((l, i) => (
            <li data-i style={`--i:${i}`}><a href={l.href} class="flex min-h-12 items-center text-base text-muted transition-colors duration-200 hover:text-fg">{l.label}</a></li>
          ))}
        </ul>
        <div data-i style={`--i:${links.length}`}><Button href={book} lang={lang} track="book_click" class="mt-3 w-full">{t.book}</Button></div>
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    let isOpen = false;
    menu.hidden = false;
    menu.setAttribute('inert', '');
    const set = (open: boolean, returnFocus = false) => {
      isOpen = open;
      menu.classList.toggle('is-open', open);
      menu.toggleAttribute('inert', !open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', (open ? btn.dataset.labelClose : btn.dataset.labelOpen) ?? '');
      btn.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      btn.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
      if (open) menu.querySelector<HTMLElement>('a')?.focus();
      else if (returnFocus) btn.focus();
    };
    btn.addEventListener('click', () => set(!isOpen));
    menu.addEventListener('click', (e) => (e.target as Element).closest('a') && set(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) set(false, true);
    });
    // Close when focus leaves the header (e.g. Tab past the last menu item).
    document.querySelector('[data-header]')?.addEventListener('focusout', (e) => {
      const next = (e as FocusEvent).relatedTarget as Node | null;
      if (isOpen && next && !btn.closest('header')!.contains(next)) set(false);
    });
    matchMedia('(min-width: 64rem)').addEventListener('change', (m) => m.matches && set(false));
  }
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', scrollY > 8);
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
