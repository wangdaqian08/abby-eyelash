---
// Site footer: NAP (identical text everywhere, from site.ts), hours, contact, socials, service links, language switch.
import { services, type Lang } from '../data/services';
import { site } from '../data/site';
import { common, hoursRows, mapsUrl, napAddress } from '../i18n/common';
import { localePath } from '../lib/i18n';
import LangSwitch from './ui/LangSwitch.astro';
import ContactLinks from './ui/ContactLinks.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = common[lang].footer;
const head = ['font-medium text-fg', lang === 'en' ? 'text-xs uppercase tracking-[0.2em]' : 'text-sm'];
const link = 'inline-flex min-h-11 items-center text-muted transition-colors duration-200 hover:text-fg sm:min-h-9';
---
<footer class="border-t border-border bg-surface-2/50 text-sm">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:grid-cols-2 sm:px-6 lg:grid-cols-[1fr_0.8fr_1.2fr_1.5fr] lg:gap-12">
    <div>
      <p class="font-serif text-2xl text-primary">{site.name}</p>
      <p class:list={[head, "mt-6"]}>{t.visit}</p>
      <address class="mt-3 not-italic text-muted">
        <a href={mapsUrl(site)} data-track="map_click" target="_blank" rel="noopener" class="inline-block py-1.5 underline-offset-4 hover:text-fg hover:underline">{napAddress(site)}</a>
      </address>
    </div>

    <div>
      <p class:list={head}>{t.services}</p>
      <ul class="mt-2">
        {services.map((s) => <li><a href={localePath(lang, s.slug)} class={link}>{s.name[lang]}</a></li>)}
        <li><a href={localePath(lang, '/book')} data-track="book_click" class={link.replace('text-muted', 'text-primary')}>{t.bookOnline} →</a></li>
      </ul>
    </div>

    <div>
      <p class:list={head}>{t.hours}</p>
      <dl class="mt-3 space-y-2 text-muted">
        {hoursRows(site.hours, lang).map((r) => (
          <div class="grid grid-cols-[1fr_auto] items-baseline gap-x-4"><dt>{r.days}</dt><dd class="whitespace-nowrap text-right tabular-nums">{r.time}</dd></div>
        ))}
      </dl>
    </div>

    <div>
      <p class:list={head}>{t.contact}</p>
      <div class="mt-3"><ContactLinks lang={lang} /></div>
    </div>
  </div>

  <div class="border-t border-border">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 py-4 text-xs text-muted sm:flex-row sm:px-6">
      <p>© {new Date().getFullYear()} {site.name} · {napAddress(site)}</p>
      <div class="flex items-center gap-4">
        <a href={localePath(lang, '/privacy')} class="inline-flex min-h-11 items-center underline-offset-4 hover:text-fg hover:underline sm:min-h-9">{t.privacy}</a>
        <button type="button" data-cookie-settings class="inline-flex min-h-11 items-center underline-offset-4 hover:text-fg hover:underline sm:min-h-9">{t.cookieSettings}</button>
        <LangSwitch lang={lang} />
      </div>
    </div>
  </div>
</footer>

<script>
  // Copy icon turns into a tick with a "Copied" status for 2.5 s; a second click restarts the timer.
  // Clipboard API needs a secure context (https/localhost); plain http (LAN preview) and some in-app browsers lack it.
  const copy = async (text: string) => {
    if (navigator.clipboard) return navigator.clipboard.writeText(text);
    const ta = Object.assign(document.createElement('textarea'), { value: text, readOnly: true });
    ta.style.cssText = 'position:fixed;opacity:0';
    document.body.append(ta);
    ta.select();
    const ok = document.execCommand('copy');
    ta.remove();
    if (!ok) throw new Error('copy failed');
  };
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const status = b.querySelector('[data-copy-status]')!;
    const icon = b.querySelector('[data-copy-icon]')!;
    const tick = b.querySelector('[data-copy-tick]')!;
    let timer: number | undefined;
    const show = (copied: boolean) => {
      icon.toggleAttribute('hidden', copied);
      tick.toggleAttribute('hidden', !copied);
      status.textContent = copied ? b.dataset.copied! : ((status as HTMLElement).dataset.idle ?? '');
    };
    b.addEventListener('click', async () => {
      try {
        await copy(b.dataset.copy!);
        show(true);
        clearTimeout(timer);
        timer = window.setTimeout(() => show(false), 2500);
      } catch {}
    });
  });
</script>
